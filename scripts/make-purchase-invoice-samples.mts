// Writes the demo's sample supplier invoices (D-60) into src/lib/automation/purchase-invoices/samples-data.ts
// as base64, so the app serves them with no PDF library at run time. Re-run after changing
// fixtures/samples.ts:
//
//   pnpm dlx tsx scripts/make-purchase-invoice-samples.mts
//
// The output is deterministic (fixed PDF dates), and a test checks it still matches the specs.
import { writeFileSync } from "node:fs";
import path from "node:path";
import { SAMPLE_SPECS, samplePdf } from "../src/lib/automation/purchase-invoices/fixtures/samples";

const out = path.join(import.meta.dirname, "../src/lib/automation/purchase-invoices/samples-data.ts");
const entries: string[] = [];
for (const spec of SAMPLE_SPECS) {
  const b64 = Buffer.from(await samplePdf(spec)).toString("base64");
  entries.push(`  ${JSON.stringify(spec.id)}:\n    ${JSON.stringify(b64)},`);
}
writeFileSync(
  out,
  `// Generated by scripts/make-purchase-invoice-samples.mts from fixtures/samples.ts. Don't edit by hand.\n// Invented supplier invoices for the demo store (D-60), as base64 PDFs.\n\nexport const SAMPLE_PDFS: Record<string, string> = {\n${entries.join("\n")}\n};\n`,
);
console.log(`Wrote ${SAMPLE_SPECS.length} samples to ${out}`);
