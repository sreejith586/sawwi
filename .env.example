# Copy to .env.local and fill in. Without a key, Sawwi still maps columns using
# saved mappings and known column names, and asks one-click questions for the rest.
ANTHROPIC_API_KEY=

# Optional: where the local SQLite database and uploaded files live (default: ./.data)
# SAWWI_DATA_DIR=

# Comma-separated emails that get the superadmin console (/admin): paywall switch,
# trial length, sign-ups, plans per workspace. Only settable here, never from the app.
SAWWI_SUPERADMIN_EMAILS=

# Encrypts connection tokens at rest (Settings → Connections). 32 bytes, base64 or hex:
#   openssl rand -base64 32
# Without it, connections can't be added. Keep it secret and stable: changing it makes stored tokens unreadable.
SAWWI_CONNECTOR_KEY=

# ─── Stripe (card checkout for paid plans) ───────────────────────────────
# Use test-mode keys while developing: https://dashboard.stripe.com/test/apikeys
# Checkout only appears once the superadmin turns the paywall on in /admin.
# In Dashboard > Settings > Payment methods, turn on Cards and Link.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring monthly Price IDs (price_...) for each plan sold online.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints it.
STRIPE_WEBHOOK_SECRET=
# Public address of the app. Link previews default to https://sawwi.hypermaxsolutions.com;
# Stripe return links default to the address the request came in on. Set it to pin both
# (e.g. a staging host).
# APP_URL=https://sawwi.hypermaxsolutions.com
