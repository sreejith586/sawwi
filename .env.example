# Copy to .env.local and fill in. Without a key, Sawwi still maps columns using
# saved mappings and known column names, and asks one-click questions for the rest.
ANTHROPIC_API_KEY=

# Database (D-37). Leave unset locally: Sawwi runs an in-process Postgres (PGlite) under
# ./.data/pglite. Set it to use a real Postgres, e.g. a Neon branch. Required on Vercel.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# (SAWWI_DATABASE_URL is read too: the name Vercel's Neon integration uses with the "SAWWI" prefix.)
# Connections per server instance when DATABASE_URL is set (default 5).
# SAWWI_DB_POOL=

# Files (D-39). Leave unset locally: files go under ./.data/files. On Vercel, connecting a
# private Blob store adds BLOB_STORE_ID, and the SDK signs in with the deployment's OIDC token.
# A read-write token also works (e.g. to use the store from your machine):
# BLOB_READ_WRITE_TOKEN=

# Optional: where the local database and uploaded files live (default: ./.data)
# SAWWI_DATA_DIR=

# Comma-separated emails that get the superadmin console (/admin): paywall switch,
# trial length, sign-ups, plans per workspace. Only settable here, never from the app.
SAWWI_SUPERADMIN_EMAILS=

# Encrypts connection tokens at rest (Settings → Connections), D-40. A key ring: "id:key" entries,
# comma-separated, the first one active; each key 32 bytes, base64 or hex (`openssl rand -base64 32`).
#   SAWWI_CONNECTOR_KEYS=k1:<key>
# To rotate: SAWWI_CONNECTOR_KEYS=k2:<new>,k1:<old>, redeploy, Admin → Connection secrets → Re-encrypt,
# then drop k1. Without a key, connections can't be added. Never remove a key that still has secrets.
SAWWI_CONNECTOR_KEYS=
# The older single key still works (it counts as key "k0"):
# SAWWI_CONNECTOR_KEY=

# Protects /api/cron/tick, which Vercel Cron calls every 15 minutes (D-42). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Without it, background jobs are off.
#   openssl rand -base64 32
CRON_SECRET=

# The live demo store ("Try the live demo" on the login and landing pages): on unless set to off.
SAWWI_DEMO=

# ─── Stripe (card checkout for paid plans) ───────────────────────────────
# Use test-mode keys while developing: https://dashboard.stripe.com/test/apikeys
# Checkout only appears once the superadmin turns the paywall on in /admin.
# In Dashboard > Settings > Payment methods, turn on Cards and Link.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring monthly Price IDs (price_...) for each plan sold online.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints it.
STRIPE_WEBHOOK_SECRET=
# Public address of the app. Link previews default to https://sawwiapp.ai;
# Stripe return links default to the address the request came in on. Set it to pin both
# (e.g. a staging host).
# APP_URL=https://sawwiapp.ai
